# Server
PORT=8080
APP_ENV=dev

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=liteflow
DB_USERNAME=liteflow
DB_PASSWORD=

# JWT
JWT_SECRET=liteflow-default-jwt-secret-key-for-dev-only-32chars
JWT_ACCESS_EXPIRATION=7200
REFRESH_TOKEN_EXPIRATION=2592000

# SMS
SMS_PROVIDER=mock
ALIYUN_SMS_KEY_ID=
ALIYUN_SMS_KEY_SECRET=
ALIYUN_SMS_ENDPOINT=dysmsapi.aliyuncs.com
ALIYUN_SMS_TEMPLATE_CODE=

# LLM
LLM_DEFAULT_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_ENDPOINT=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat
QWEN_API_KEY=
QWEN_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
QWEN_MODEL=qwen-max
OPENROUTER_API_KEY=
OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
CF_AI_GATEWAY_ENDPOINT=
CF_AI_GATEWAY_MODEL=@cf/meta/llama-3.1-8b-instruct
CF_AIG_TOKEN=

# Search
SEARCH_PROVIDER=metaso
METASO_API_KEY=
METASO_ENDPOINT=https://metaso.cn/api/open
TAVILY_API_KEY=
TAVILY_ENDPOINT=https://api.tavily.com
SEARCH_MAX_CONTENT_TOKENS=3000
SEARCH_FETCH_TIMEOUT=20

# Storage
STORAGE_BASE_PATH=./storage
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_KEY_ID=
ALIYUN_OSS_KEY_SECRET=

# MCP OAuth
MCP_OAUTH_CALLBACK_URL=http://localhost:3000/chat/connectors/oauth-callback
MCP_OAUTH_GITHUB_CLIENT_ID=
MCP_OAUTH_GITHUB_CLIENT_SECRET=
MCP_OAUTH_GITHUB_SCOPE=repo,read:org

# Feishu
FEISHU_ENABLED=false
FEISHU_HEALTH_CHECK_MS=60000

# Tasks
TASKS_ENABLED=true
TASKS_POOL_SIZE=4
TASKS_MAX_PER_USER=10
TASKS_MIN_INTERVAL=10
TASKS_MAX_TOKENS=50000
TASKS_MAX_RUNS_PER_DAY=24
TASKS_MAX_DAILY_TOKENS=500000
TASKS_EXECUTION_TIMEOUT=120
TASKS_RETENTION_DAYS=30

# Admin
SUPER_ADMIN_PHONE=13426112101

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# Debug
DEBUG_ENABLED=true

# Frontend URL
FRONTEND_URL=http://localhost:3000
